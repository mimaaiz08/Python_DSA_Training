# Stack concepts append() & pop()
def create_stack():
    stack=[]
    return stack

def check_empty(stack):
    return len(stack)==0

def push(stack, item):
    stack.append(item)
    print("Pushed item: "+ item)

def pop(stack):
    if (check_empty(stack)):
        return "Stack is Empty"
    return stack.pop()

stack = create_stack()
print(stack)
pop(stack)
push(stack, str(1))
push(stack, str(2))
push(stack, str(3))
push(stack, str(4))
print(stack)
print("Poped item: ", pop(stack))
print("Stack after popping an element:",stack)
