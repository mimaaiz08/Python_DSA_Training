#pattern problem using * symbol
# nxm matrix
n = int(input())
m = int(input())
for i in range(0,n):
    for i in range(0,m):
        print("*",end=" ")
    print("\n")

# triangle 
n = int(input())
m = int(input())
for i in range(0,n):
    for j in range(0,m):
        if i>=j:
            print("*",end=" ")
    print("\n")

# triangle i<=j
n = int(input())
m = int(input())
for i in range(0,n):
    for j in range(0,m):
        if i<=j:
            print("*",end=" ")
        else:
            print(" ",end=" ")
    print("\n")
