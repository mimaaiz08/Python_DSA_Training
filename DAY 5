# Stack using LinkedList
class Node:
    def __init__(self,d):
        self.data=d
        self.next=None
class stack:
    def __init__(self):
        self.top=None
    def push(self, d):
        newnode=Node(d)
        if self.top==None:
            self.top=newnode
        else:
            newnode.next=self.top
            self.top=newnode
    def pop(self):
        if self.top==None:
            return "Stack is Empty"
        else:
            self.top=self.top.next
    def peek(self):
        if self.top==None:
            return "Stack is Empty"
        else:
            print(self.top.data)
    def print(self):
        cur=self.top
        while cur:
            print(cur.data,end="->")
            cur=cur.next
Stack=stack()
Stack.push(1)
Stack.push(2)
Stack.push(3)
Stack.push(4)
Stack.print()
print("\n")
Stack.peek()
Stack.pop()
Stack.print()

# Queue using list having dequeue and enqueue
class Queue():
    def __init__(self,k):
        self.k=k
        self.queue=[None]*k
        self.head=self.tail=-1
        
    def enqueue(self, data):
        if (self.tail==self.k-1):
            print("The queue is full\n")
        elif (self.head==-1):
            self.head=0
            self.tail=0
            self.queue[self.tail]=data
        else:
            self.tail=self.tail+1
            self.queue[self.tail]=data
            
    def dequeue(self):
        if (self.head==-1):
            print("The queue is empty\n")
        elif (self.head==self.tail):
            temp=self.queue[self.head]
            self.head=-1
            self.tail=-1
            return temp
        else:
            temp=self.queue[self.head]
            self.head=self.head+1
            return temp
    
    def printQueue(self):
        if (self.head==-1):
            print("No element in the queue")
        else:
            for i in range(self.head,self.tail+1):
                print(self.queue[i],end=" ")
        print()
    
    def peek(self):
        print("Fist Element: ",self.queue[self.tail])
queue=Queue(5)
queue.enqueue(1)
queue.enqueue(2)
queue.enqueue(3)
queue.enqueue(4)
queue.enqueue(5)
print("Initial Queue: ")
queue.printQueue()
queue.peek()
queue.dequeue()
print("Aftre removing an element from the queue: ")
queue.printQueue()

