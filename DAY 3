#pattern problem using * symbol
# nxm matrix
n = int(input())
m = int(input())
for i in range(0,n):
    for i in range(0,m):
        print("*",end=" ")
    print("\n")

# triangle 
n = int(input())
m = int(input())
for i in range(0,n):
    for j in range(0,m):
        if i>=j:
            print("*",end=" ")
    print("\n")

# triangle i<=j
n = int(input())
m = int(input())
for i in range(0,n):
    for j in range(0,m):
        if i<=j:
            print("*",end=" ")
        else:
            print(" ",end=" ")
    print("\n")

# triangle with incrementing numbers 
n = int(input())
count=1
for i in range(0,n):
    for j in range(0,n):
        if i>=j:
            print(count,end=" ")
            count+=1
        else:
            print(" ",end=" ")
    print("\n")

# triangle with incrementing numbers for each row starting with 1 
n = int(input())
count=1
for i in range(0,n):
    for j in range(0,n):
        if i>=j:
            print(count,end=" ")
            count+=1
        else:
            print(" ",end=" ")
    count=1
    print("\n")

# upper & lower triangle with incrementing numbers 
n = int(input())
count=1
for i in range(0,n):
    for j in range(0,n):
        if i>=j :
            print(count,end=" ")
            count+=1
        else:
            print(" ",end=" ")
    print("\n")
for i in range(0,n-1):
    for j in range(0,n-1):
        if i<=j:
            print(count,end=" ")
            count+=1
    print("\n")

# rectangle
n = int(input())
m = int(input())
for i in range(0,n):
    for j in range(0,m):
        if i==0 or j==n-1 or j==0 or i==n-1:
            print("*",end=" ")
        else:
            print(" ",end=" ")
    print("\n")

# Z formation using *
n=int(input())
m=int(input())
for i in range(0,n):
    for j in range(0,m):
        if i==0 or i==n-1 or i+j==n-1:
            print("*",end=" ")
        else:
            print(" ",end=" ")
    print("\n")
